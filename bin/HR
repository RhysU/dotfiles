#!/usr/bin/env bash
# Draw a tall horizontal rule across the terminal, HR as in HTML
set -euo pipefail

usage() {
  cat <<EOF
Usage: ${0##*/} [-h] [CHAR]

Draw a tall horizontal rule across the terminal, HR as in HTML.
Rule with CHAR, defaulting to '#', one line per word of the date.

Options:
  -h    Show this help and exit
EOF
}

while getopts "h" OPT; do
  case "$OPT" in
    h) usage; exit 0 ;;
    *) exit 1 ;;
  esac
done
shift $((OPTIND - 1))

[[ $# -le 1 ]] || { echo >&2 "${0##*/}: too many arguments"; exit 1; }

# Fall back to a classic terminal, since a failed tput leaves no width.
cols=$(tput cols 2>/dev/null) || cols=80

# Leave the date unquoted.  Word splitting drives the rule's height, since
# printf reuses a one-conversion format once per word it is handed.
# shellcheck disable=SC2046
printf "%${cols}s\n" $(date) | tr ' ' "${1:-#}"

# To properly test, confirm expected behavior against:
#   -h            -> usage on stdout, exit 0
#   -x            -> getopts diagnostic on stderr, exit 1
#   two args      -> one-line error on stderr, exit 1
#   (no args)     -> rule of '#', one line per word of date
#   '='           -> same rule drawn in '='
#   LC_ALL=C      -> six lines, the date's word count
#   no TERM       -> eighty columns, nothing on stderr
#   vim :r!HR     -> rule only, no trailing blank
