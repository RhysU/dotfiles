#!/usr/bin/env bash
# Run a tool under libtool, so it sees the real binary and not the wrapper
set -euo pipefail

usage() {
  cat <<EOF
Usage: ${0##*/} [-h] PROGRAM [ARG...]

Run PROGRAM under libtool, so the tool sees the real binary.
The invoked name picks the tool, so libtoolgdb runs gdb and libtoolddd ddd.
Symlink a new name to gain a new tool: 'ln -s libtoolgdb libtoolnm'.

Options:
  -h    Show this help and exit
EOF
}

[[ ${1-} != -h ]] || { usage; exit 0; }

tool="${0##*/}"
tool="${tool#libtool}"

exec libtool --mode=execute "$tool" "$@"

# To properly test, confirm expected behavior against:
#   libtoolgdb -h       -> usage naming libtoolgdb, exit 0
#   libtoolddd -h       -> same usage naming libtoolddd, exit 0
#   fresh libtoolnm link -> runs nm, no edit to this file
#   (no args)           -> the tool's own usage through libtool
#   a libtool binary    -> the tool sees the real executable
#   -q prog             -> the flag reaches the tool
#   a name with no libtool prefix -> tries that name, exec says not found
#   link to a missing tool -> exec fails naming it, exit 127
