#!/usr/bin/env bash
# Run valgrind under libtool with every local suppression file applied
set -euo pipefail

usage() {
  cat <<EOF
Usage: ${0##*/} [-h] PROGRAM [ARG...]

Run PROGRAM under libtool and valgrind, attaching gdb on demand.
Apply every .supp file in ~/.valgrind.

Options:
  -h    Show this help and exit
EOF
}

[[ ${1-} != -h ]] || { usage; exit 0; }

# Collect suppressions per run.
supps=()
for supp in "$HOME"/.valgrind/*.supp; do
  [[ -e $supp ]] && supps+=(--suppressions="$supp")
done

exec libtool --mode=execute valgrind \
  --db-command='gdb -tui -w %f %p' "${supps[@]}" "$@"

# To properly test, confirm expected behavior against:
#   -h                    -> usage on stdout, exit 0
#   (no args)             -> valgrind's own usage through libtool
#   no ~/.valgrind at all  -> runs with no --suppressions argument
#   one .supp file        -> exactly one --suppressions argument
#   two .supp files       -> both passed
#   a .supp added mid-session -> picked up on the next run
#   a path holding spaces -> passed as one argument
#   --leak-check=full prog -> the flag reaches valgrind
