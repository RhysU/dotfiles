#!/usr/bin/env bash
# Wrap text at seventy-eight columns
set -euo pipefail

usage() {
  cat <<EOF
Usage: ${0##*/} [-h] [FMT_ARG...] [FILE...]

Wrap FILE at seventy-eight columns, or standard input when given none.
Every argument reaches fmt untouched.

Options:
  -h    Show this help and exit, when given first
EOF
}

[[ ${1-} != -h ]] || { usage; exit 0; }

exec fmt -w 78 "$@"

# To properly test, confirm expected behavior against:
#   -h            -> usage on stdout, exit 0
#   (no args)     -> wraps standard input
#   one file      -> wraps that file
#   two files     -> wraps both, as fmt does
#   -s file       -> -s reaches fmt
#   -h after a file -> reaches fmt, not us
#   missing file  -> fmt's own error, nonzero exit
