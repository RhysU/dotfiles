#!/bin/bash
# audio-cycle: Cycle through pre-defined audio sink/source pairs
#              so that both speakers and microphones change together
#              Moves whichever half is present, so a missing microphone
#              still lets the speakers switch
#              Falls back to the first present device when nothing matches

# Format: "Name|sink|source" - define available devices across all machines
entries=(
    "Fortress-Audioengine-Brio|alsa_output.usb-Generic_USB_Audio_20210726905926-00.analog-stereo|alsa_input.usb-046d_Brio_101_2511APVFKRX8-02.mono-fallback"
    "Fortress-Jabra-Jabra|alsa_output.usb-GN_Audio_A_S_Jabra_EVOLVE_30_II_0000CC93561A07-00.analog-stereo|alsa_input.usb-GN_Audio_A_S_Jabra_EVOLVE_30_II_0000CC93561A07-00.mono-fallback"
    "Kitchen-Audioengine-Brio|alsa_output.pci-0000_00_1f.3.analog-stereo|alsa_input.usb-046d_Brio_101_2444APVA1QP8-02.mono-fallback"
)

notify() { notify-send -t 2500 "Audio Cycle" "$1" 2>/dev/null; echo "$1"; }

# Move whichever defaults this machine has, recording skips in $skipped
activate() {
    skipped=""
    if [ -n "$1" ] && grep -qxF "$1" <<< "$sinks"; then
        pactl set-default-sink "$1"   || { notify "Cannot set sink $1";   exit 1; }
    else
        skipped+=" - speakers unchanged"
    fi
    if [ -n "$2" ] && grep -qxF "$2" <<< "$sources"; then
        pactl set-default-source "$2" || { notify "Cannot set source $2"; exit 1; }
    else
        skipped+=" - microphone unchanged"
    fi
}

command -v pactl &>/dev/null || { notify "pactl not found"; exit 1; }

# Get available devices
sinks=$(pactl list short sinks 2>/dev/null | cut -f2)
sources=$(pactl list short sources 2>/dev/null | cut -f2)

[ -z "$sinks" ] && [ -z "$sources" ] && { notify "No audio devices found"; exit 1; }

# Keep entries with either half present; the sink alone says which is current
# Entries must therefore have distinct sinks
current_sink=$(pactl get-default-sink 2>/dev/null)
filtered=()
current_idx=-1
for entry in "${entries[@]}"; do
    IFS='|' read -r _ sink source <<< "$entry"
    grep -qxF "$sink" <<< "$sinks" || grep -qxF "$source" <<< "$sources" || continue
    [ "$sink" = "$current_sink" ] && current_idx=${#filtered[@]}
    filtered+=("$entry")
done

# Fall back to the first present device, skipping monitor sources
if [ ${#filtered[@]} -eq 0 ]; then
    sink=$(head -n1 <<< "$sinks")
    source=$(grep -v '\.monitor$' <<< "$sources" | head -n1)
    [ -z "$sink" ] && { notify "No sinks available"; exit 1; }
    activate "$sink" "$source"
    notify "No matching pairs - using $sink$skipped"
    exit 0
fi

# Advance to next entry, wrapping around
next=$(( (current_idx + 1) % ${#filtered[@]} ))
IFS='|' read -r name sink source <<< "${filtered[$next]}"
activate "$sink" "$source"
notify "Using $name$skipped"

# Test plan: stub pactl on PATH, feed it synthetic device lists, and check
#   Both halves present         cycles pairs and wraps at the end
#   Source missing              speakers still advance, mic left alone
#   Sink missing                mic still advances, speakers left alone
#   Split state across entries  the sink alone says where we are
#   Nothing known present       falls back, skipping .monitor sources
#   No sources at all           speakers advance, no empty name reaches pactl
#   pactl rejects a device      aborts loudly, no success message
