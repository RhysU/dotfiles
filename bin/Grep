#!/usr/bin/env bash
# Search on a freshly cleared display with the command line echoed
set -euo pipefail

# The invoked name picks the tool, so Grep runs grep, EGrep egrep, Ag ag.
tool="${0##*/}"
tool="${tool,,}"

usage() {
  cat <<EOF
Usage: ${0##*/} [-h] [${tool^^}_ARG...]

Run $tool on a freshly cleared display with the command line echoed.
The screen is reoriented by reo, short for reorient.
Symlink a new name to gain a new tool: 'ln -s Grep Ag'.

Options:
  -h    Show this help and exit
EOF
}

[[ ${1-} != -h ]] || { usage; exit 0; }

# Colour grep and egrep as the aliases do, numbering each match.
# Ag does both on a terminal unasked.
case "$tool" in
  grep|egrep) set -- --color=auto --line-number "$@" ;;
esac

reo .
prog=$(type -P "$tool")
boldecho "+ $prog${*:+$(printf ' %q' "$@")}"
exec "$prog" "$@"

# To properly test, confirm expected behavior against:
#   Grep -h, Ag -h  -> usage naming the invoked one, exit 0
#   EGrep 'a|b'     -> egrep runs, alternation matches, flags echoed
#   Grep foo file   -> cleared screen, echoed command with --color=auto,
#                      matches prefixed line: for one file
#   Grep -h foo     -> usage, not grep's --no-filename
#   Grep foo -h a b -> -h reaches grep, dropping filenames
#   Ag foo          -> echoed command without the grep flags
#   colour          -> present on a terminal, absent through a pipe
#   an argument with a space -> quoted in the echo, intact for the tool
#   -r, -i, --      -> reach the tool, not us
#   no match        -> the tool's exit status 1 reaches the caller
#   tool absent     -> type -P fails, nothing echoed
