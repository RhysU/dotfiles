#!/usr/bin/env bash
# Reorient the screen, reo being short for reorient
set -euo pipefail

usage() {
  cat <<EOF
Usage: ${0##*/} [-h] [LS_ARG...]

Reorient the screen, reo being short for reorient.
Clear it, print the working directory in bold, then list.

Options:
  -h    Show this help and exit
EOF
}

[[ ${1-} != -h ]] || { usage; exit 0; }

# Prefer GNU ls where it is spelled gls, since BSD ls has no --color.
lsprog="ls"
command -v gls >/dev/null 2>&1 && lsprog="gls"

# Clear the terminal itself, so a redirected stdout still starts clean.
clear 2>/dev/null > /dev/tty || true
boldecho "$PWD"
echo
"$lsprog" --color=auto "$@"
echo

# To properly test, confirm expected behavior against:
#   -h            -> usage on stdout, exit 0
#   (no args)     -> clears, bold cwd, listing, blank lines around it
#   a directory   -> lists that directory instead
#   -l            -> long format, as the function gave
#   colour        -> present on a terminal, absent through a pipe
#   gls on PATH   -> chosen over ls, as the rc function did
#   no tty at all -> no clear, no stderr noise, listing still printed
#   missing path  -> ls's own error, nonzero exit
