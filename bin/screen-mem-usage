#!/usr/bin/env bash
renice -n 10 "$$" >/dev/null
delay=1
total_mem=$(free --mega | awk '$1 == "Mem:" { print $2 }')
if command -v nvidia-smi >/dev/null; then
    while(true); do
      current_gpu=$(nvidia-smi 2>/dev/null | awk '/% /{printf "%4s", $13}')
      current_mem=$(free --mega | awk '$1 == "Mem:" { print $3 }')
      echo "[${current_gpu}]GPU ${current_mem}/${total_mem}MB"
      sleep $delay
    done
else
    while(true); do
      current_mem=$(free --mega | awk '$1 == "Mem:" { print $3 }')
      echo "${current_mem}/${total_mem}MB"
      sleep $delay
    done
fi
