#!/usr/bin/env bash
# Run gdb's terminal interface under libtool
set -euo pipefail

usage() {
  cat <<EOF
Usage: ${0##*/} [-h] PROGRAM [ARG...]

Run gdb's terminal interface under libtool.

Options:
  -h    Show this help and exit
EOF
}

[[ ${1-} != -h ]] || { usage; exit 0; }

exec libtoolgdb -tui "$@"

# To properly test, confirm expected behavior against:
#   -h               -> usage on stdout, exit 0
#   (no args)        -> gdb's terminal interface with no program loaded
#   a libtool binary -> gdb sees the real executable
#   --args prog x    -> --args reaches gdb
#   argv             -> matches libtoolgdb -tui exactly
