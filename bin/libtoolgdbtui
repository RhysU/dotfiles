#!/usr/bin/env bash
# Run gdb's terminal interface under libtool
set -euo pipefail

usage() {
  cat <<EOF
Usage: ${0##*/} [-h] PROGRAM [ARG...]

Run PROGRAM under libtool --mode=execute with gdb in its terminal
interface.  Every argument reaches gdb untouched.

Options:
  -h    Show this help and exit, when given first
EOF
}

[[ ${1-} != -h ]] || { usage; exit 0; }

exec libtool --mode=execute gdb -tui "$@"

# To properly test, confirm expected behavior against:
#   -h               -> usage on stdout, exit 0
#   (no args)        -> gdb's terminal interface with no program loaded
#   a libtool binary -> gdb sees the real executable
#   --args prog x    -> --args reaches gdb
#   libtool absent   -> exec fails naming libtool, exit 127
