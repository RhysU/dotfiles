#!/usr/bin/env bash
# Print the arguments in bold
set -euo pipefail

usage() {
  cat <<EOF
Usage: ${0##*/} [-h] [TEXT...]

Print TEXT in bold, joined by single spaces.

Options:
  -h    Show this help and exit
EOF
}

[[ ${1-} != -h ]] || { usage; exit 0; }

printf '\033[1m%s\033[22m\n' "$*"

# To properly test, confirm expected behavior against:
#   -h            -> usage on stdout, exit 0
#   (no args)     -> an empty bold line, as the function gave
#   two words     -> both on one line, joined by a space
#   -x            -> printed in bold, not treated as an option
#   piped to cat  -> escapes still emitted, as the function did
