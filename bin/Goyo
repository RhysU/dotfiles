#!/usr/bin/env bash
# Open a file in Vim in Goyo's distraction-free mode
set -euo pipefail

usage() {
  cat <<EOF
Usage: ${0##*/} [-h] FILE [NEEDLE]

Open FILE in Vim in Goyo's distraction-free mode.
Given NEEDLE, a fixed string, open at its first matching line.
Requires Vim plugin https://github.com/junegunn/goyo.vim.

Options:
  -h    Show this help and exit
EOF
}

while getopts "h" OPT; do
  case "$OPT" in
    h) usage; exit 0 ;;
    *) exit 1 ;;
  esac
done
shift $((OPTIND - 1))

[[ $# -eq 1 || $# -eq 2 ]] || { usage >&2; exit 1; }
[[ $# -eq 1 ]] && exec vim -c "Goyo" -- "$1"

[[ -f $1 ]] || { echo "${0##*/}: no such file $1" >&2; exit 1; }

match=$(grep -n -m 1 -F -e "$2" -- "$1") || {
  echo "${0##*/}: no match for '$2' in $1" >&2
  exit 1
}
exec vim "+${match%%:*}" -c "Goyo" -- "$1"

# To properly test, confirm expected behavior against:
#   -h             -> usage on stdout, exit 0
#   -x             -> getopts diagnostic on stderr, exit 1
#   (no args)      -> usage on stderr, exit 1
#   three args     -> usage on stderr, exit 1
#   an extant file -> that file, centered and soft-wrapped
#   a missing file -> new buffer under that name, likewise centered
#   a file named -foo -> edited, not parsed as a flag
#   a matching needle -> that file, opened at the first matching line
#   a needle like -foo -> matched, not parsed as a flag
#   an absent needle  -> no match diagnostic on stderr, exit 1
#   a needle with a missing file -> no such file on stderr, exit 1
