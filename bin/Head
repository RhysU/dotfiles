#!/usr/bin/env bash
# Print exactly one screenful of a file, from its top or from its end
set -euo pipefail

# The invoked name picks the tool, so Head runs head and Tail runs tail.
tool="${0##*/}"
tool="${tool,,}"

usage() {
  cat <<EOF
Usage: ${0##*/} [-h] [${tool^^}_ARG...] [FILE...]

Print exactly one screenful of FILE through $tool, or of standard input.
Leave the last line for the prompt.
Colour it with vim on a terminal, as view does, then exit.
Symlink a new name to gain a new tool: 'ln -s Head Tail'.

Options:
  -h    Show this help and exit
EOF
}

[[ ${1-} != -h ]] || { usage; exit 0; }

# Fall back to a classic terminal, since a failed tput leaves -1 lines.
lines=$(tput lines 2>/dev/null) || lines=24

# Colour one named file on a terminal.  The slice keeps its basename,
# since vim reads the syntax from the name and a stdin buffer carries none.
# Emptying t_ti and t_te keeps vim off the alternate screen, so what it
# paints survives its own exit and no keypress is owed.  Emptying t_fe and
# t_BE stops vim enabling focus and paste reporting: it quits without
# entering its input loop, so a terminal's reply would reach the shell.
if [[ -t 1 && $# -eq 1 && -r ${1-} ]]; then
  work=$(mktemp -d)
  trap 'rm -rf "$work"' EXIT
  "$tool" -n $((lines - 1)) -- "$1" > "$work/${1##*/}"
  paint=(
    vim -XR -u NONE -N                                  # no vimrc, no plugins
    --cmd 'set t_ti= t_te='                             # off the alternate screen
    --cmd 'set t_fe= t_fd= t_BE= t_BD='                 # ask the terminal nothing
    --cmd 'set shortmess+=F'                            # no "7L, 134B" line
    -c 'syntax on'                                      # also detects the filetype
    -c 'set nonumber laststatus=0 noruler noshowcmd'
    -c "let &fillchars = 'eob: '"                       # blanks below, not tildes
    -c 'redraw' -c 'q'
  )
  "${paint[@]}" "$work/${1##*/}"
  # Vim paints every row it owns and leaves the cursor on the last.  Put it
  # back under the text and erase below, so the prompt follows the content.
  # Count with grep, not wc, which misses a last line lacking its newline.
  printf '\033[%d;1H\033[J' "$(( $(grep -c '' "$work/${1##*/}") + 1 ))"
  exit
fi

exec "$tool" -n $((lines - 1)) "$@"

# To properly test, confirm expected behavior against:
#   Head -h, Tail -h -> usage naming the invoked one, exit 0
#   (no args)       -> one screenful of standard input
#   a long file     -> one screenful, prompt still visible
#   a short file    -> the whole file
#   Head -c 10 file -> -c reaches head and wins over our -n
#   Tail -f file    -> -f reaches tail
#   no TERM         -> twenty-four lines, nothing on stderr
#   one file on a tty -> coloured, prompt straight back, no keypress
#   alternate screen  -> never entered, so the text stays after vim exits
#   vim's file message, tildes -> suppressed, nothing but the content
#   piped           -> plain, so Head file | tail -3 still works
#   two files       -> plain, headers as head and tail give them
#   slice name      -> the temp copy carries the basename, or syntax is lost
#   temp dir        -> removed on exit, including when vim fails
#   a link named neither -> exec fails naming the derived tool, exit 127
#
# Screen behaviour needs a real terminal, since a script(1) pty neither
# answers vim's queries nor renders what it paints.  Use tmux:
#   tmux new-session -d -s p -x 80 -y 24 'bash --norc'
#   tmux send-keys -t p "PS1='P> '; clear" Enter
#   tmux send-keys -t p 'Head FILE' Enter
#   tmux capture-pane -t p -p | grep -n .
# The prompt should sit on the row directly below the last content line,
# for a one-line file and for one filling the screen alike.
