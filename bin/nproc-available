#!/usr/bin/env bash
# Report usable CPUs, honoring CPU affinity and every cgroup CPU quota
set -euo pipefail

usage() {
  cat <<EOF
Usage: ${0##*/} [-h]

Report usable CPUs, honoring CPU affinity and every cgroup CPU quota.
Never report less than one.

Options:
  -h    Show this help and exit
EOF
}

while getopts "h" OPT; do
  case "$OPT" in
    h) usage; exit 0 ;;
    *) exit 1 ;;
  esac
done
shift $((OPTIND - 1))

[[ $# -eq 0 ]] || { echo >&2 "${0##*/}: takes no arguments"; exit 1; }

# Emit every directory holding a cgroup cap that binds this process.  Take
# each controller's mount from mountinfo, since v2 is not always at
# /sys/fs/cgroup and v1 splits cpu from cpuacct, then walk leaf to root.
cgroup_dirs() {
  local -a f
  local i mount path dir
  while read -ra f; do
    for ((i = 6; i < ${#f[@]}; i++)); do
      [[ ${f[i]} == - ]] && break
    done
    case ${f[i+1]-} in
      cgroup2) path=$(awk -F: '$1 == "0" { print $3; exit }' /proc/self/cgroup) ;;
      cgroup)  [[ ${f[i+3]-} =~ (^|,)cpu(,|$) ]] || continue
               path=$(awk -F: '$2 ~ /(^|,)cpu(,|$)/ { print $3; exit }' /proc/self/cgroup) ;;
      *)       continue ;;
    esac
    mount=${f[4]}
    dir=$mount${path%/}
    [[ -d $dir ]] || dir=$mount        # namespaced view hides the host path
    while :; do
      printf '%s\n' "$dir"
      [[ $dir != "$mount" ]] || break
      dir=${dir%/*}
    done
  done < /proc/self/mountinfo
}

# Print a directory's cap in whole CPUs, rounding up, or nothing if uncapped.
cap_of() {
  local quota period
  read -r quota period 2>/dev/null < "$1/cpu.max" ||
    { read -r quota 2>/dev/null < "$1/cpu.cfs_quota_us" &&
      read -r period 2>/dev/null < "$1/cpu.cfs_period_us"; } || return 0
  [[ $quota =~ ^[0-9]+$ && $period =~ ^[1-9][0-9]*$ ]] || return 0
  printf '%s\n' "$(( (quota + period - 1) / period ))"
}

available=$(nproc)
while read -r dir; do
  cap=$(cap_of "$dir")
  [[ -n $cap && $cap -lt $available ]] && available=$cap
done < <(cgroup_dirs)

printf '%s\n' "$(( available > 0 ? available : 1 ))"

# To properly test, confirm expected behavior against:
#   -h                        -> usage on stdout, exit 0
#   -x                        -> getopts diagnostic on stderr, exit 1
#   any argument              -> one-line error on stderr, exit 1
#   unconstrained host        -> agrees with nproc, nothing on stderr
#   taskset -c 0              -> 1, via affinity
#   v2 at a non-standard path -> found through mountinfo, not a fixed path
#   v1 cpu split from cpuacct -> cpu mount chosen, cpuacct ignored
#   quota only on an ancestor -> that ancestor's cap wins
#   tightest of several caps  -> smallest wins
#   'max' or -1 quota         -> ignored, no cap
#   garbage in cpu.max        -> ignored rather than fatal
#   leaf path absent on host  -> falls back to the mount root
#   no cgroup controller      -> silent, agrees with nproc
