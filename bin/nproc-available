#!/usr/bin/env bash
# Report usable CPUs, honoring CPU affinity and every cgroup CPU quota
set -euo pipefail

usage() {
  cat <<EOF
Usage: ${0##*/} [-h]

Report usable CPUs, honoring CPU affinity and every cgroup CPU quota.
Never report less than one.

Options:
  -h    Show this help and exit
EOF
}

while getopts "h" OPT; do
  case "$OPT" in
    h) usage; exit 0 ;;
    *) exit 1 ;;
  esac
done
shift $((OPTIND - 1))

[[ $# -eq 0 ]] || { echo >&2 "${0##*/}: takes no arguments"; exit 1; }

# Count online CPUs, falling back as each source proves unavailable.
# Capture rather than print, since grep -c emits a 0 before it fails.
cpu_count() {
  local n
  n=$(nproc 2>/dev/null) ||
    n=$(getconf _NPROCESSORS_ONLN 2>/dev/null) ||
    n=$(grep -c '^processor' /proc/cpuinfo 2>/dev/null) ||
    n=1
  [[ $n =~ ^[1-9][0-9]*$ ]] || n=1
  printf '%s\n' "$n"
}

# Print where the named cgroup filesystem is mounted, cpu controller only for v1.
cgroup_mount() {
  local -a f
  local i
  while read -ra f; do
    for ((i = 6; i < ${#f[@]}; i++)); do
      [[ ${f[i]} == - ]] && break
    done
    [[ ${f[i+1]-} == "$1" ]] || continue
    [[ $1 != cgroup || ${f[i+3]-} =~ (^|,)cpu(,|$) ]] || continue
    printf '%s\n' "${f[4]}"
    return
  done < /proc/self/mountinfo
}

# Print this process's path within the unified hierarchy.
v2_path() {
  local id ctrl path
  while IFS=: read -r id ctrl path; do
    [[ $id == 0 ]] || continue
    printf '%s\n' "$path"
    return
  done < /proc/self/cgroup
}

# Print this process's path under the v1 cpu controller, never cpuacct.
v1_path() {
  local id ctrl path
  while IFS=: read -r id ctrl path; do
    [[ $ctrl =~ (^|,)cpu(,|$) ]] || continue
    printf '%s\n' "$path"
    return
  done < /proc/self/cgroup
}

# Walk from the leaf cgroup to the mount root, since a cap on any ancestor binds.
cgroup_dirs() {
  local mount=$1 dir=$1${2%/}
  [[ -d $dir ]] || dir=$mount          # namespaced view hides the host path
  while :; do
    printf '%s\n' "$dir"
    [[ $dir != "$mount" ]] || break
    dir=${dir%/*}
  done
}

# Round up, so a quota of 1.5 CPUs feeds -j2.
ceil_div() {
  [[ $1 =~ ^[0-9]+$ && $2 =~ ^[1-9][0-9]*$ ]] || return 1
  printf '%s\n' "$(( ($1 + $2 - 1) / $2 ))"
}

# Emit one CPU cap per cgroup v2 ancestor that sets one.
limits_v2() {
  local mount dir quota period
  mount=$(cgroup_mount cgroup2)
  [[ -n $mount ]] || return 0
  while read -r dir; do
    read -r quota period 2>/dev/null < "$dir/cpu.max" || continue
    ceil_div "$quota" "$period" || continue
  done < <(cgroup_dirs "$mount" "$(v2_path)")
}

# Emit one CPU cap per cgroup v1 ancestor that sets one.
limits_v1() {
  local mount dir quota period
  mount=$(cgroup_mount cgroup)
  [[ -n $mount ]] || return 0
  while read -r dir; do
    read -r quota 2>/dev/null < "$dir/cpu.cfs_quota_us" || continue
    read -r period 2>/dev/null < "$dir/cpu.cfs_period_us" || continue
    ceil_div "$quota" "$period" || continue
  done < <(cgroup_dirs "$mount" "$(v1_path)")
}

mapfile -t limits < <(limits_v2; limits_v1)
available=$(cpu_count)
for limit in "${limits[@]}"; do
  if (( limit < available )); then available=$limit; fi
done

printf '%s\n' "$(( available > 0 ? available : 1 ))"

# To properly test, confirm expected behavior against:
#   -h                        -> usage on stdout, exit 0
#   -x                        -> getopts diagnostic on stderr, exit 1
#   any argument              -> one-line error on stderr, exit 1
#   unconstrained host        -> agrees with nproc, nothing on stderr
#   taskset -c 0              -> 1, via affinity
#   v2 at a non-standard path -> found through mountinfo, not a fixed path
#   v1 cpu split from cpuacct -> cpu mount chosen, cpuacct ignored
#   quota only on an ancestor -> that ancestor's cap wins
#   tightest of several caps  -> smallest wins
#   'max' or -1 quota         -> ignored, no cap
#   garbage in cpu.max        -> ignored rather than fatal
#   leaf path absent on host  -> falls back to the mount root
#   no cgroup controller      -> silent, agrees with nproc
