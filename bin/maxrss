#!/usr/bin/env bash
# Report the maximum resident set size of a command
set -euo pipefail

usage() {
  cat <<EOF
Usage: ${0##*/} [-h] COMMAND [ARG...]

Report the maximum resident set size of COMMAND, in kilobytes.

Options:
  -h    Show this help and exit
EOF
}

[[ ${1-} != -h ]] || { usage; exit 0; }

[[ $# -ge 1 ]] || { echo >&2 "${0##*/}: missing command"; exit 1; }

# After exec, time is a plain word, so GNU time is found wherever PATH puts it.
exec time -f "\nMaximum resident set size (Kb): %M" "$@"

# To properly test, confirm expected behavior against:
#   -h                  -> usage on stdout, exit 0
#   (no args)           -> one-line error on stderr, exit 1
#   true                -> reports a size, exit 0
#   false               -> reports a size, exit 1
#   grep -h pattern     -> -h reaches grep, not us
#   nonexistent command -> GNU time's own error, nonzero exit
#   GNU time absent     -> exec fails naming time, exit 127
