#!/usr/bin/env bash
# Emit on stdout how to quote stdin for bash
# Lifted from https://news.ycombinator.com/item?id=24659282
set -euo pipefail

usage() {
  cat <<EOF
Usage: ${0##*/} [-h] [FILE...]

Emit on stdout how to quote stdin, or FILE, for bash.

Options:
  -h    Show this help and exit
EOF
}

[[ ${1-} != -h ]] || { usage; exit 0; }

# Capture first, so a failing cat stops us rather than quoting nothing.
text=$(cat "$@")
printf '%q\n' "$text"

# To properly test, confirm expected behavior against:
#   -h              -> usage on stdout, exit 0
#   plain word      -> echoed unchanged
#   spaces, quotes  -> quoted so eval reproduces the input
#   embedded $HOME  -> quoted, not expanded
#   empty stdin     -> ''
#   binary stdin    -> $'...' form
#   one file        -> that file's contents quoted
#   two files       -> both, concatenated, as one word
#   missing file    -> cat's own error, nonzero exit
