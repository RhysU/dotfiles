#!/usr/bin/env bash
# Emit on stdout how to quote stdin for bash
# Lifted from https://news.ycombinator.com/item?id=24659282
set -euo pipefail

usage() {
  cat <<EOF
Usage: ${0##*/} [-h]

Read standard input and emit it quoted as a single word bash will
reproduce verbatim.  Handy for pasting a blob into a command line.

Options:
  -h    Show this help and exit
EOF
}

while getopts "h" OPT; do
  case "$OPT" in
    h) usage; exit 0 ;;
    *) exit 1 ;;
  esac
done
shift $((OPTIND - 1))

[[ $# -eq 0 ]] || { echo >&2 "${0##*/}: takes no arguments"; exit 1; }

printf '%q\n' "$(cat)"

# To properly test, confirm expected behavior against:
#   -h              -> usage on stdout, exit 0
#   -x              -> getopts diagnostic on stderr, exit 1
#   any argument    -> one-line error on stderr, exit 1
#   plain word      -> echoed unchanged
#   spaces, quotes  -> quoted so eval reproduces the input
#   embedded $HOME  -> quoted, not expanded
#   empty stdin     -> ''
#   binary stdin    -> $'...' form
