#!/bin/bash
# taildiff - show a file's diffs as it is edited in place

FILE=
CUMULATIVE=false
EMPTY=false
INTERVAL=2

usage() {
    cat <<EOF
Usage: $(basename "$0") [-a] [-e] [-i SECS] FILE

Watch FILE with inotify and print a colored git diff each time it
changes, labeling the sides before and after.  Batch the diffs, so a
burst of writes costs one diff rather than one per write.  Follow a
file whose writer keeps it open, such as a daemon appending to its
log.  Exit when FILE is removed or renamed.

Arguments:
  FILE     file to watch

Options:
  -a       diff against the startup snapshot, so edits accumulate.
           Default is to diff against the version last shown
  -e       start from an empty file, so the first diff spells out the
           whole of FILE.  Under -a every later diff does the same
  -i SECS  show at most one diff every SECS seconds, batching whatever
           arrives in between.  Default $INTERVAL
  -h       show this help and exit

Examples:
  $(basename "$0") /var/log/myapp.log
  $(basename "$0") -a -e /var/log/myapp.log
  $(basename "$0") -i 10 /var/log/chatty.log
EOF
}

# Print what FILE gained since the reference, then advance it.  One
# snapshot feeds both the diff and the reference, so the two can never
# disagree over what was shown.  Promote by rename to keep the reference
# whole.
update() {
    touch "$stamp"
    cp "$FILE" "$after" || exit 1
    git -C "$refdir" --no-pager diff --no-index --no-prefix \
        "before/$base" "after/$base"
    $CUMULATIVE || mv "$after" "$before" || exit 1
}

while getopts "aehi:" opt; do
    case "$opt" in
        a) CUMULATIVE=true ;;
        e) EMPTY=true ;;
        i) INTERVAL=$OPTARG ;;
        h) usage; exit 0 ;;
        *) usage >&2; exit 1 ;;
    esac
done
shift $((OPTIND-1))
FILE=${1:-}

if [[ -z "$FILE" || ! -f "$FILE" ]]; then
    echo "Error: '$FILE' is not a regular file" >&2
    usage >&2
    exit 1
fi
if [[ ! "$INTERVAL" =~ ^[1-9][0-9]*$ ]]; then
    echo "Error: -i wants a whole number of seconds, not '$INTERVAL'" >&2
    exit 1
fi
if ! command -v inotifywait >/dev/null 2>&1; then
    echo "Error: inotifywait not found (install inotify-tools)" >&2
    exit 1
fi
if ! command -v git >/dev/null 2>&1; then
    echo "Error: git not found" >&2
    exit 1
fi

refdir=$(mktemp -d) && mkdir "$refdir/before" "$refdir/after"
base=$(basename "$FILE")
before="$refdir/before/$base"
after="$refdir/after/$base"
stamp="$refdir/stamp"
if $EMPTY; then
    : > "$before"
else
    cp "$FILE" "$before"
fi
touch "$stamp"
trap 'rm -rf "$refdir"' EXIT

$EMPTY && update

# Wake on every write, and again whenever the watch idles out.  An event
# alone decides that work is pending; the stamp is only a backstop for
# events that fired while git held the loop.  Timestamps a tick apart
# compare equal, so read an equal stamp as stale and diff again.
last=$((SECONDS - INTERVAL))
pending=false
while :; do
    inotifywait -qq -t "$INTERVAL" -e modify -e close_write "$FILE" 2>/dev/null
    case $? in
        0) pending=true ;;
        2) ;;
        *) break ;;
    esac
    $pending || [[ ! "$stamp" -nt "$FILE" ]] || continue
    ((SECONDS - last >= INTERVAL)) || continue
    update
    pending=false
    last=$SECONDS
done

# Exercised against, in brief:
#
#   options   -h, -a, -e, -i, a bad flag, a bad interval, a missing or
#             non-regular FILE, an absent inotifywait or git
#   diffs     incremental, cumulative, truncating rewrite, absent final
#             newline, a name holding a space, the before and after labels
#   timing    batching a burst, flushing its tail, staying quiet when idle
#   races     a writer holding FILE open, two hundred hammered writes all
#             accounted for, an mtime tying the stamp read as stale
#   lifetime  exit on removal, exit on rename
