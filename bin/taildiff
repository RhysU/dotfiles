#!/bin/bash
# taildiff - show a file's diffs as it is edited in place

FILE=
CUMULATIVE=false
EMPTY=false

usage() {
    cat <<EOF
Usage: $(basename "$0") [-a] [-e] FILE

Print a colored diff of FILE each time it is written, using inotify
and git diff. Exits when FILE is removed or renamed.

Arguments:
  FILE     file to watch

Options:
  -a       diff against the original snapshot. Default is to diff
           against the last-seen version, showing only new edits
  -e       diff against an empty file at startup. The first diff
           shows the entire file as additions
  -h       Show this help and exit

Examples:
  $(basename "$0") /var/log/myapp.log
  $(basename "$0") -a -e /var/log/myapp.log
EOF
}

showdiff() {
    git --no-pager diff --no-index "$@"
}

while getopts "aeh" opt; do
    case "$opt" in
        a) CUMULATIVE=true ;;
        e) EMPTY=true ;;
        h) usage; exit 0 ;;
        *) usage >&2; exit 1 ;;
    esac
done
shift $((OPTIND-1))
FILE=${1:-}

if [[ -z "$FILE" || ! -f "$FILE" ]]; then
    echo "Error: '$FILE' is not a regular file" >&2
    usage >&2
    exit 1
fi
if ! command -v inotifywait >/dev/null 2>&1; then
    echo "Error: inotifywait not found (install inotify-tools)" >&2
    exit 1
fi
if ! command -v git >/dev/null 2>&1; then
    echo "Error: git not found" >&2
    exit 1
fi

refdir=$(mktemp -d) && ref="$refdir/$(basename "$FILE")"
if $EMPTY; then
    : > "$ref"
else
    cp "$FILE" "$ref"
fi
trap 'rm -rf "$refdir"' EXIT

if $EMPTY; then
    showdiff /dev/null "$FILE"
fi

while inotifywait -qq -e close_write "$FILE" 2>/dev/null; do
    showdiff "$ref" "$FILE"
    $CUMULATIVE || cp "$FILE" "$ref"
done
