#!/bin/bash
# taildiff - show a file's diffs as it is edited in place

PROG=$(basename "$0")
CUMULATIVE=false
EMPTY=false
INTERVAL=2

usage() {
    cat <<EOF
Usage: $PROG [-a] [-e] [-i SECS] FILE

Watch FILE with inotify and print a colored git diff as it changes,
labeling the sides before and after.  Batch a burst into one diff.
Follow a file whose writer keeps it open, such as a daemon appending
to its log, and one replaced by rename, as an editor does on save.
Exit when FILE is removed.

Options:
  -a       diff against the startup snapshot, so edits accumulate.
           Default diffs against the version last shown
  -e       start from an empty file, so the first diff spells out
           FILE.  Under -a so does every later diff
  -i SECS  show at most one diff every SECS seconds.  Default $INTERVAL
  -h       show this help and exit

Examples:
  $PROG /var/log/myapp.log
  $PROG -a -e /var/log/myapp.log
  $PROG -i 10 /var/log/chatty.log
EOF
}

die() {
    echo "Error: $*" >&2
    exit 1
}

# Diff FILE against the reference and advance it.  One snapshot feeds
# both, so what is shown and what is remembered cannot diverge.  Stamp
# first, so a write racing the snapshot is not mistaken for seen.
update() {
    touch "$stamp"
    cp "$FILE" "$after" || exit 1
    git -C "$refdir" --no-pager diff --no-index --no-prefix \
        "before/$base" "after/$base"
    $CUMULATIVE || mv "$after" "$before" || exit 1
}

# The watch died.  Editors save by writing a new file over the old, so
# follow the replacement.  A removal, or a watch that never took, ends
# the run instead.
rewatch() {
    local ino
    ino=$(stat -c %i "$FILE" 2>/dev/null) || return 1
    [[ "$ino" != "$watched" ]] || return 1
    watched=$ino
}

while getopts "aehi:" opt; do
    case "$opt" in
        a) CUMULATIVE=true ;;
        e) EMPTY=true ;;
        i) INTERVAL=$OPTARG ;;
        h) usage; exit 0 ;;
        *) usage >&2; exit 1 ;;
    esac
done
shift $((OPTIND-1))
FILE=${1:-}

[[ -f "$FILE" ]] || { usage >&2; die "'$FILE' is not a regular file"; }
[[ "$INTERVAL" =~ ^[1-9][0-9]*$ ]] ||
    die "-i wants whole seconds, got '$INTERVAL'"
command -v inotifywait >/dev/null ||
    die "inotifywait not found; install inotify-tools"
command -v git >/dev/null || die "git not found"

refdir=$(mktemp -d) || exit 1
trap 'rm -rf "$refdir"' EXIT
mkdir "$refdir/before" "$refdir/after" || exit 1
base=$(basename "$FILE")
before="$refdir/before/$base"
after="$refdir/after/$base"
stamp="$refdir/stamp"

if $EMPTY; then
    : > "$before"
    update
else
    cp "$FILE" "$before" || exit 1
    touch "$stamp"
fi

# Wake on a write, or on the watch idling out.  Events raised while git
# ran are lost, so the stamp, never the event, says whether work waits.
# A write within a tick of the stamp ties it, so read a tie as stale.
last=$((SECONDS - INTERVAL))                 # fire on the first write
watched=$(stat -c %i "$FILE") || exit 1
while :; do
    inotifywait -qq -t "$INTERVAL" -e modify -e close_write "$FILE"
    case $? in
        0|2) ;;
        *)   rewatch || break ;;
    esac
    ((SECONDS - last >= INTERVAL)) || continue   # too soon
    [[ "$stamp" -nt "$FILE" ]] && continue       # nothing new
    update
    last=$SECONDS
done

# Exercised against, in brief:
#
#   options   -h, -a, -e, -i, bad flag, bad interval, missing or
#             non-regular FILE, absent inotifywait or git
#   diffs     incremental, cumulative, truncating rewrite, absent final
#             newline, a name holding a space, the before/after labels
#   timing    batching a burst, flushing its tail, quiet when idle
#   races     a writer holding FILE open, two hundred hammered writes
#             accounted for, an mtime tying the stamp read as stale
#   lifetime  exit on removal, following a rename
