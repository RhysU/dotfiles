#!/usr/bin/env bash
# Run git on the bare repository holding these dotfiles, adopted from
# https://developer.atlassian.com/blog/2016/02/best-way-to-store-dotfiles-git-bare-repo/
set -euo pipefail

default_repo="git@github.com:RhysU/dotfiles.git"

usage() {
  cat <<EOF
Usage: ${0##*/} [-h] [install [REPO] | GIT_ARG...]

Run git on the bare repository holding these dotfiles.
The repository lives in ~/.dotfiles and its work tree is ~.

Commands:
  install [REPO]  Check out REPO into ~ on a fresh machine, then Vundle's plugins
                  REPO defaults to $default_repo
  add, commit, push, pull, ...
                  Any git subcommand, run on ~/.dotfiles

Options:
  -h    Show this help and exit
EOF
}

default_branch() {
  local head ref
  # Guard explicitly, since set -e lapses inside the caller's $(...)
  head=$(command git ls-remote --exit-code --symref "$1" HEAD) || return
  # Split "ref: refs/heads/NAME<TAB>HEAD", which leads when HEAD is symbolic
  read -r _ ref _ <<<"$head"
  [[ $ref = refs/heads/* ]] || { echo >&2 "${0##*/}: $1 has no default branch"; return 1; }
  echo "${ref#refs/heads/}"
}

# Run in a subshell, confining set -x and cd to the install
install() (
  # Assign apart from local, which would mask a failed $(...)
  local self branch url=$1
  # Resolve this script first, since a relative $0 breaks after cd
  self=$(realpath -- "$0")
  # Enter the work tree, since git submodule refuses to run outside it
  cd "$HOME"
  # Refuse early, before anything lands in ~
  [[ -n $url ]] || { echo >&2 "${0##*/}: empty REPO"; exit 1; }
  command -v vim >/dev/null || { echo >&2 "${0##*/}: install needs vim"; exit 1; }
  [[ ! -e .dotfiles ]] || { echo >&2 "${0##*/}: ~/.dotfiles already exists"; exit 1; }
  [[ ! -e .vim/bundle/Vundle.vim ]] || { echo >&2 "${0##*/}: ~/.vim/bundle/Vundle.vim already exists"; exit 1; }
  set -x
  # Ask the repository its default branch, proving it answers
  branch=$(default_branch "$url")
  "$self" init
  "$self" config --local status.showUntrackedFiles no
  "$self" remote add origin "$url"
  "$self" fetch
  "$self" checkout "origin/$branch" -ft
  "$self" submodule update --init --recursive
  command git clone https://github.com/VundleVim/Vundle.vim.git "$HOME/.vim/bundle/Vundle.vim"
  vim +BundleUpdate +qall
)

[[ ${1-} != -h ]] || { usage; exit 0; }

# Claim install, since git has no such subcommand
if [[ ${1-} = install ]]; then
  [[ ${2-} != -h ]] || { usage; exit 0; }
  [[ $# -le 2 ]] || { echo >&2 "${0##*/}: install takes at most one REPO"; exit 1; }
  install "${2-$default_repo}"
  exit 0
fi

command git "--git-dir=$HOME/.dotfiles" "--work-tree=$HOME" "$@"

# To properly test, confirm expected behavior against:
#   -h              -> usage on stdout, exit 0
#   (no args)       -> git's own usage
#   status          -> tracked files only, untracked hidden
#   --version       -> reaches git, not us
#   from a subdir   -> paths still resolve against ~
#   an argument with a space -> intact for git
#   no ~/.dotfiles  -> git's own complaint, nonzero exit
#   failing git     -> git's exit status reaches the caller
#   install         -> each step echoed, plugins in ~, exit 0
#   install from /  -> works as from ~
#   bash dotfiles install -> still finds itself
#   install REPO    -> origin is REPO, not the default
#   unreachable REPO -> ls-remote fails, no ~/.dotfiles, nonzero exit
#   empty REPO      -> ls-remote fails with exit 2, no ~/.dotfiles
#   REPO on main    -> checks out main tracking origin/main
#   install a b     -> one-line error on stderr, exit 1
#   no vim on PATH  -> one-line error, no ~/.dotfiles, exit 1
#   install -h      -> usage on stdout, exit 0
#   install ""      -> one-line error, no ~/.dotfiles, exit 1
#   install twice   -> refuses over ~/.dotfiles, exit 1
#   Vundle present  -> refuses over Vundle.vim, no ~/.dotfiles, exit 1
#   trace           -> ends at vim, no "+ exit 0"
