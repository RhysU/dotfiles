#!/usr/bin/env bash
# Record a command and its resource usage into a fresh typescript
set -Ceuo pipefail

usage() {
  cat <<EOF
Usage: ${0##*/} [-h] COMMAND [ARG...]

Record COMMAND under script(1) and GNU time into a fresh typescript.
Name it typescript-HOST-SECONDS-HEX, with six random hex digits.
Head it with the command line, the date, and one blank line.
Fail when the quoted command exceeds what Linux passes as one argument.

Options:
  -h    Show this help and exit
EOF
}

[[ ${1-} != -h ]] || { usage; exit 0; }

[[ $# -ge 1 ]] || { echo >&2 "${0##*/}: missing command"; exit 1; }

# Resolve GNU time here, since the shell under script reads time as a keyword.
time=$(type -P time)
script=$(type -P script)
printf -v args ' %q' "$@"
printf -v cmd 'SHELL=%q exec %q --verbose --%s' "${SHELL-}" "$time" "$args"

# Linux caps each argument, here the whole command, below 32 pages.
size=$(LC_ALL=C; echo "${#cmd}")
(( size < 32 * $(getconf PAGESIZE) )) || { echo >&2 "${0##*/}: command too long"; exit 1; }

host=$(uname -n)
printf -v now '%(%s)T' -1
# Draw RANDOM twice, since each draw gives only 15 of the 24 bits.
hex=$(( (RANDOM << 15 | RANDOM) & 0xFFFFFF ))
printf -v file 'typescript-%s-%s-%06X' "${host%%.*}" "$now" "$hex"

printf '+%s\n' "$args" >"$file"
# Match date's default format at the instant naming the file.
printf '%(%a %b %e %H:%M:%S %Z %Y)T\n' "$now" >>"$file"
printf '\n' >>"$file"
# Pin script's shell to bash, which understands the quoting of printf %q.
SHELL=$BASH exec "$script" --quiet --append --return --command "$cmd" -- "$file"

# To properly test, confirm expected behavior against:
#   -h                  -> usage on stdout, exit 0
#   (no args)           -> one-line error on stderr, exit 1
#   echo HI             -> file holds '+ echo HI', the date, a blank line, HI, then time
#   false               -> recorded, exit 1
#   grep -h pattern     -> -h reaches grep, not us
#   an argument with a space -> quoted in the header, intact for the command
#   SHELL=/bin/sh       -> $'...' arguments still reach the command intact
#   SHELL=/bin/zsh      -> the command sees /bin/zsh, not bash
#   GNU time absent     -> type -P fails, no file written
#   HOSTNAME=a/b        -> ignored, the kernel's hostname names the file
#   script absent      -> type -P fails, no file written
#   32k small arguments -> one-line error on stderr, exit 1, no file written
#   multibyte arguments -> counted in bytes, not characters
#   file already exists -> noclobber refuses, file untouched, exit 1
