# Source every drop-in in sorted order.  Numeric prefixes fix that order.
# Drop-ins named *.local.sh hold private content and are never committed.
for element in ~/.bashrc.d/*.sh
do
    if [ -r "$element" ]; then
        #echo "Sourcing $element" 1>&2  # Uncomment to trace startup
        . "$element"
    fi
done
unset element
